<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <CoverletInclude>[Asm.Domain.SourceGenerators]*</CoverletInclude>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ahead of the generator's own reference, which stays on the oldest Roslyn it needs so the
         generator loads in as many compilers as possible. The harness compiles the generated code,
         and that code uses `field`, so the harness needs a C# 14 compiler. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.6.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Asm.Domain\Asm.Domain.csproj" />
    <!-- Analyzer as well as reference: the unit tests drive the generator directly, and the
         integration tests need it to have run over this project's own entities. -->
    <ProjectReference Include="..\..\src\Asm.Domain.SourceGenerators\Asm.Domain.SourceGenerators.csproj"
                      OutputItemType="Analyzer" />
  </ItemGroup>

</Project>
